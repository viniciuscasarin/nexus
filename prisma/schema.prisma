datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PersonalInfo {
  id       Int     @id @default(autoincrement())
  fullName String
  email    String
  phone    String?
  location String?
  summary  String?
}

model Experience {
  id          Int     @id @default(autoincrement())
  company     String
  position    String
  startDate   String?
  endDate     String?
  current     Boolean @default(false)
  description String
}

model Education {
  id           Int     @id @default(autoincrement())
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String?
  endDate      String?
}

model Skill {
  id          Int    @id @default(autoincrement())
  name        String
  description String
}

model JobApplication {
  id               Int             @id @default(autoincrement())
  title            String
  company          String
  link             String?
  description      String
  status           String          @default("INTERESTED")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tailoredResumeId Int?
  tailoredResume   TailoredResume? @relation(fields: [tailoredResumeId], references: [id])
  comments         Comment[]
}

model TailoredResume {
  id              Int              @id @default(autoincrement())
  content         String
  createdAt       DateTime         @default(now())
  jobApplications JobApplication[]
}

model Comment {
  id               Int            @id @default(autoincrement())
  content          String
  createdAt        DateTime       @default(now())
  jobApplicationId Int
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
}
